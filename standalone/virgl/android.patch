--- a/src/vrend/andronix_present.c
+++ b/src/vrend/andronix_present.c
@@ -0,0 +1,307 @@
+/*
+ * Andronix (standalone app): zero-copy present for GPU windows.
+ *
+ * An X11 window's frame normally comes back to the guest by readback
+ * (glReadPixels into its shared memory), the guest puts it into Xvfb, and
+ * the app uploads Xvfb's framebuffer again. Here, when the app asks for it
+ * (VTEST_PRESENT_SOCKET, its listening socket, and VTEST_PRESENT_SIZE_FILE,
+ * one "W H" line per window size the app can show: the full screen, and
+ * windows whose size is unique and that nothing covers), a display-target
+ * readback of one of those sizes is replaced by a GPU blit into one of
+ * three AHardwareBuffers the app shows directly, at the window's place. The guest's copy is then
+ * left as it was (it puts a stale frame into Xvfb, which the app ignores
+ * while frames come this way).
+ *
+ * Protocol (SOCK_SEQPACKET, the server connects):
+ *   1. "ANXP" u32 version=1, width, height, count   (one message)
+ *   2. count x AHardwareBuffer_sendHandleToUnixSocket
+ *   3. per frame: "ANXF" u32 index, flags (1 = rows bottom-up), seq,
+ *      with the blit's native fence fd (SCM_RIGHTS) when there is one.
+ * Any error: the connection is dropped and readbacks go on as before.
+ *
+ * MIT, like virglrenderer.
+ */
+#ifdef __ANDROID__
+
+#include <android/hardware_buffer.h>
+#include <epoxy/egl.h>
+#include <epoxy/gl.h>
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/un.h>
+#include <time.h>
+#include <unistd.h>
+
+#include "virgl_hw.h"
+#include "vrend_renderer.h"
+#include "andronix_present.h"
+
+#define NBUF 3
+
+static int enabled = -1, have_fence, failures;
+static const char *sock_path, *size_path;
+static int conn = -1;
+static uint32_t buf_w, buf_h, seq, next_buf;
+static AHardwareBuffer *ahb[NBUF];
+static EGLImageKHR img[NBUF];
+static GLuint tex[NBUF], fbo[NBUF];
+static EGLContext made_in;
+#define MAX_SIZES 16
+static uint32_t sizes[MAX_SIZES][2];
+static int n_sizes;
+static double size_checked, retry_after;
+static struct timespec size_mtime;
+
+static double now_ms(void)
+{
+   struct timespec t;
+   clock_gettime(CLOCK_MONOTONIC, &t);
+   return t.tv_sec * 1e3 + t.tv_nsec / 1e6;
+}
+
+static void drop(const char *why)
+{
+   if (why)
+      fprintf(stderr, "present: off (%s)\n", why);
+   if (conn >= 0)
+      close(conn);
+   conn = -1;
+   EGLDisplay dpy = eglGetCurrentDisplay();
+   bool same_ctx = made_in == eglGetCurrentContext();
+   for (int i = 0; i < NBUF; i++) {
+      if (fbo[i] && same_ctx)
+         glDeleteFramebuffers(1, &fbo[i]);
+      if (tex[i] && same_ctx)
+         glDeleteTextures(1, &tex[i]);
+      if (img[i] != EGL_NO_IMAGE_KHR && dpy != EGL_NO_DISPLAY)
+         eglDestroyImageKHR(dpy, img[i]);
+      if (ahb[i])
+         AHardwareBuffer_release(ahb[i]);
+      fbo[i] = tex[i] = 0;
+      img[i] = EGL_NO_IMAGE_KHR;
+      ahb[i] = NULL;
+   }
+   buf_w = buf_h = 0;
+   /* The app may not listen yet: try again in a second. Three failures in a
+    * row (not a connection the app closed after using it) and this client
+    * stays on the readback for good. */
+   retry_after = now_ms() + 1000;
+}
+
+/* The sizes the app can show, as it wrote them (re-read when the file
+ * changes, at most every 100 ms: a menu opening over a window must take it
+ * off quickly). The app writes a temporary file and renames it over this
+ * one, so a read always sees a whole list, never half of one (which could
+ * send the wrong window this way). */
+static void read_sizes(void)
+{
+   double t = now_ms();
+   if (t - size_checked < 100)
+      return;
+   size_checked = t;
+   struct stat st;
+   if (stat(size_path, &st) != 0) {
+      n_sizes = 0;
+      return;
+   }
+   if (st.st_mtim.tv_sec == size_mtime.tv_sec && st.st_mtim.tv_nsec == size_mtime.tv_nsec)
+      return;
+   size_mtime = st.st_mtim;
+   FILE *f = fopen(size_path, "r");
+   unsigned w, h;
+   n_sizes = 0;
+   if (f) {
+      while (n_sizes < MAX_SIZES && fscanf(f, "%u %u", &w, &h) == 2) {
+         sizes[n_sizes][0] = w;
+         sizes[n_sizes][1] = h;
+         n_sizes++;
+      }
+      fclose(f);
+   }
+}
+
+static bool size_listed(uint32_t w, uint32_t h)
+{
+   for (int i = 0; i < n_sizes; i++)
+      if (sizes[i][0] == w && sizes[i][1] == h)
+         return true;
+   return false;
+}
+
+static bool send_all(const void *p, size_t n, int fence_fd)
+{
+   struct iovec iov = { (void *)p, n };
+   struct msghdr m = { 0 };
+   char cbuf[CMSG_SPACE(sizeof(int))];
+   m.msg_iov = &iov;
+   m.msg_iovlen = 1;
+   if (fence_fd >= 0) {
+      memset(cbuf, 0, sizeof(cbuf));
+      m.msg_control = cbuf;
+      m.msg_controllen = sizeof(cbuf);
+      struct cmsghdr *c = CMSG_FIRSTHDR(&m);
+      c->cmsg_level = SOL_SOCKET;
+      c->cmsg_type = SCM_RIGHTS;
+      c->cmsg_len = CMSG_LEN(sizeof(int));
+      memcpy(CMSG_DATA(c), &fence_fd, sizeof(int));
+   }
+   return sendmsg(conn, &m, MSG_NOSIGNAL) == (ssize_t)n;
+}
+
+/* Textures and FBOs on the EGLImages, in the current context. glmark2 and
+ * others make a new context per scene: the buffers and the connection stay,
+ * only these are made again. */
+static bool make_gl_objects(void)
+{
+   GLint old_draw;
+   glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &old_draw);
+   bool ok = true;
+   for (int i = 0; i < NBUF && ok; i++) {
+      glGenTextures(1, &tex[i]);
+      glBindTexture(GL_TEXTURE_2D, tex[i]);
+      glEGLImageTargetTexture2DOES(GL_TEXTURE_2D, img[i]);
+      glGenFramebuffers(1, &fbo[i]);
+      glBindFramebuffer(GL_DRAW_FRAMEBUFFER, fbo[i]);
+      glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, tex[i], 0);
+      ok = glCheckFramebufferStatus(GL_DRAW_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE;
+   }
+   glBindFramebuffer(GL_DRAW_FRAMEBUFFER, old_draw);
+   made_in = eglGetCurrentContext();
+   return ok;
+}
+
+static bool connect_app(uint32_t w, uint32_t h)
+{
+   conn = socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0);
+   struct sockaddr_un a = { .sun_family = AF_UNIX };
+   if (conn < 0 || strlen(sock_path) >= sizeof(a.sun_path))
+      return false;
+   strcpy(a.sun_path, sock_path);
+   if (connect(conn, (struct sockaddr *)&a, sizeof(a)) != 0)
+      return false;
+
+   EGLDisplay dpy = eglGetCurrentDisplay();
+   AHardwareBuffer_Desc d = {
+      .width = w, .height = h, .layers = 1,
+      .format = AHARDWAREBUFFER_FORMAT_R8G8B8A8_UNORM,
+      .usage = AHARDWAREBUFFER_USAGE_GPU_COLOR_OUTPUT | AHARDWAREBUFFER_USAGE_GPU_SAMPLED_IMAGE,
+   };
+   uint32_t hello[5] = { 0x50584e41 /* "ANXP" */, 1, w, h, NBUF };
+   if (!send_all(hello, sizeof(hello), -1))
+      return false;
+   for (int i = 0; i < NBUF; i++) {
+      if (AHardwareBuffer_allocate(&d, &ahb[i]) != 0)
+         return false;
+      if (AHardwareBuffer_sendHandleToUnixSocket(ahb[i], conn) != 0)
+         return false;
+      EGLClientBuffer cb = eglGetNativeClientBufferANDROID(ahb[i]);
+      static const EGLint attrs[] = { EGL_IMAGE_PRESERVED_KHR, EGL_TRUE, EGL_NONE };
+      img[i] = eglCreateImageKHR(dpy, EGL_NO_CONTEXT, EGL_NATIVE_BUFFER_ANDROID, cb, attrs);
+      if (img[i] == EGL_NO_IMAGE_KHR)
+         return false;
+   }
+   buf_w = w;
+   buf_h = h;
+   if (!make_gl_objects())
+      return false;
+   fprintf(stderr, "present: on, %ux%u, %d buffers\n", w, h, NBUF);
+   return true;
+}
+
+bool andronix_present_frame(struct vrend_resource *res, uint32_t level,
+                            const struct pipe_box *box, bool invert)
+{
+   if (enabled < 0) {
+      EGLDisplay dpy = eglGetCurrentDisplay();
+      sock_path = getenv("VTEST_PRESENT_SOCKET");
+      size_path = getenv("VTEST_PRESENT_SIZE_FILE");
+      /* libepoxy aborts on a call whose extension isn't advertised: check them all first. */
+      enabled = sock_path && size_path &&
+                epoxy_has_egl_extension(dpy, "EGL_KHR_image_base") &&
+                epoxy_has_egl_extension(dpy, "EGL_ANDROID_get_native_client_buffer") &&
+                epoxy_has_egl_extension(dpy, "EGL_ANDROID_image_native_buffer") &&
+                epoxy_has_gl_extension("GL_OES_EGL_image");
+      have_fence = epoxy_has_egl_extension(dpy, "EGL_KHR_fence_sync") &&
+                   epoxy_has_egl_extension(dpy, "EGL_ANDROID_native_fence_sync");
+      fprintf(stderr, "present: %s, fences %s\n", enabled ? "available" : "not available (flag or EGL/GL extensions)",
+              have_fence ? "native" : "none (glFinish)");
+   }
+   if (!enabled || level != 0 || !(res->base.bind & VIRGL_BIND_DISPLAY_TARGET) ||
+       box->x != 0 || box->y != 0 || box->z != 0 || box->depth != 1 ||
+       (uint32_t)box->width != res->base.width0 || (uint32_t)box->height != res->base.height0 ||
+       res->base.nr_samples > 1)
+      return false;
+
+   read_sizes();
+   const uint32_t rw = res->base.width0, rh = res->base.height0;
+   if (!size_listed(rw, rh)) {
+      /* Not (or no longer) a size the app shows: the readback, and let the app go. */
+      if (conn >= 0 && rw == buf_w && rh == buf_h)
+         drop("the app stopped showing this size");
+      return false;
+   }
+   if (conn >= 0 && (buf_w != rw || buf_h != rh))
+      drop("the window's size changed");
+   if (conn >= 0 && made_in != eglGetCurrentContext() && !make_gl_objects())
+      drop("couldn't use the buffers in a new context");
+   if (conn < 0) {
+      if (now_ms() < retry_after)
+         return false;
+      if (!connect_app(rw, rh)) {
+         drop(errno ? strerror(errno) : "connect");
+         if (++failures >= 3) {
+            enabled = 0;
+            fprintf(stderr, "present: off for this client (3 failures)\n");
+         }
+         return false;
+      }
+      failures = 0;
+   }
+
+   GLint old_read, old_draw;
+   glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &old_read);
+   glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &old_draw);
+   GLuint src;
+   glGenFramebuffers(1, &src);
+   glBindFramebuffer(GL_FRAMEBUFFER, src);
+   vrend_fb_bind_texture(res, 0, 0, 0);
+   uint32_t k = next_buf;
+   next_buf = (next_buf + 1) % NBUF;
+   glBindFramebuffer(GL_READ_FRAMEBUFFER, src);
+   glBindFramebuffer(GL_DRAW_FRAMEBUFFER, fbo[k]);
+   /* Rows top-down in the buffer, as the guest's readback would have had them. */
+   const GLint w = buf_w, h = buf_h;
+   if (invert)
+      glBlitFramebuffer(0, 0, w, h, 0, h, w, 0, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+   else
+      glBlitFramebuffer(0, 0, w, h, 0, 0, w, h, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+   glDeleteFramebuffers(1, &src);
+   glBindFramebuffer(GL_READ_FRAMEBUFFER, old_read);
+   glBindFramebuffer(GL_DRAW_FRAMEBUFFER, old_draw);
+
+   EGLDisplay dpy = eglGetCurrentDisplay();
+   int fence = -1;
+   EGLSyncKHR sync = have_fence ? eglCreateSyncKHR(dpy, EGL_SYNC_NATIVE_FENCE_ANDROID, NULL) : EGL_NO_SYNC_KHR;
+   glFlush();
+   if (sync != EGL_NO_SYNC_KHR) {
+      fence = eglDupNativeFenceFDANDROID(dpy, sync);
+      eglDestroySyncKHR(dpy, sync);
+   }
+   if (fence < 0)
+      glFinish(); /* no fence for the app to wait on: finish here */
+   uint32_t msg[4] = { 0x46584e41 /* "ANXF" */, k, 0, ++seq };
+   bool ok = send_all(msg, sizeof(msg), fence);
+   if (fence >= 0)
+      close(fence);
+   if (!ok) {
+      drop("the app went away");
+      return false;
+   }
+   return true;
+}
+
+#endif /* __ANDROID__ */
