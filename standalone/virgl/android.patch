+/* Andronix zero-copy present (see andronix_present.c). MIT. */
+#ifndef ANDRONIX_PRESENT_H
+#define ANDRONIX_PRESENT_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+struct vrend_resource;
+struct pipe_box;
+
+#ifdef __ANDROID__
