+/* Andronix: a B8G8R8[AX]8 readback on GLES (every X11 window's frame) reads
+ * straight into the guest's memory instead of a fresh full-frame malloc, a
+ * CPU swizzle and a second copy: BGRA where GL_EXT_read_format_bgra exists
+ * (no CPU pass), else RGBA swizzled in place; a flipped one copies once from
+ * a kept buffer. On by default; VTEST_FAST_READBACK=0 turns it off, and a GL
+ * error on the first fast readback turns it off for good (the frame is then
+ * read the old way). */
+static int vrend_fast_readback = -1, vrend_fast_bgra, vrend_fast_checked;
+static char *vrend_fast_buf;
+static size_t vrend_fast_buf_size;
+
+static bool vrend_try_fast_readback(struct vrend_resource *res,
+                                    const struct iovec *iov, int num_iovs,
+                                    const struct vrend_transfer_info *info,
+                                    bool invert)
+{
+   if (vrend_fast_readback < 0) {
+      const char *e = getenv("VTEST_FAST_READBACK");
+      vrend_fast_readback = !(e && e[0] == '0');
+      vrend_fast_bgra = epoxy_has_gl_extension("GL_EXT_read_format_bgra");
+      fprintf(stderr, "fast readback: %s (GL_EXT_read_format_bgra %d)\n",
+              vrend_fast_readback ? "on" : "off", vrend_fast_bgra);
+   }
+   enum virgl_formats fmt = res->base.format;
+   if (!vrend_fast_readback || !vrend_state.use_gles || num_iovs != 1 ||
+       (fmt != VIRGL_FORMAT_B8G8R8A8_UNORM && fmt != VIRGL_FORMAT_B8G8R8X8_UNORM) ||
+       res->base.nr_samples > 1 || info->box->depth != 1 || info->box->z != 0)
+      return false;
+
+   const uint32_t w = info->box->width, hgt = info->box->height;
+   const uint32_t h = u_minify(res->base.height0, info->level);
+   const size_t dst_stride = info->stride ? info->stride
+      : (size_t)u_minify(res->base.width0, info->level) * 4;
+   char *dst = (char *)iov[0].iov_base + info->offset;
+   if (w == 0 || hgt == 0 || dst_stride < (size_t)w * 4 ||
+       info->offset + dst_stride * (hgt - 1) + (size_t)w * 4 > iov[0].iov_len)
+      return false;
+   if (invert && (size_t)w * 4 * hgt > vrend_fast_buf_size) {
+      free(vrend_fast_buf);
+      vrend_fast_buf = malloc((size_t)w * 4 * hgt);
+      vrend_fast_buf_size = vrend_fast_buf ? (size_t)w * 4 * hgt : 0;
+      if (!vrend_fast_buf)
+         return false;
+   }
+
